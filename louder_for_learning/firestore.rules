rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Grants catalog: signed-in teachers can read; nothing can write or
    // delete from the client. Content is managed out-of-band (console /
    // admin tooling), never by the app.
    match /grants/{grantId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Teacher profile (school, subjects, Title I status, etc.): a signed-in
    // user may only read/write their own profile document, keyed by uid.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Grant applications a teacher has submitted, keyed by uid. Only the
      // owning user can read or write their own applications.
      match /applications/{applicationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
